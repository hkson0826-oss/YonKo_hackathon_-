        "authors": "Mo Chen, Zhengyuan Zhou, Claire J. Tomlin",
        "categories": [
          "math.OC"
        ],
        "createdDate": "Wed, 2 Nov 2016 02:34:59 GMT",
        "updateDate": "2016-11-03"
